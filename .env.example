# Local development only. Generate a unique key with scripts/init_local.py.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=ookular
POSTGRES_USER=ookular
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
# URL used in confirmation and password reset emails; never inferred from Host.
OOKULAR_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Local emails appear in the runserver console. No actual email is sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production use django.core.mail.backends.smtp.EmailBackend and HTTPS above.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=OOKULAR <noreply@localhost>
# Change only after configuring a trusted proxy to sanitize forwarded headers.
ALLAUTH_TRUSTED_PROXY_COUNT=0
